	"editor.semanticTokenColorCustomizations": {
		"[Dark 2026]": {
			"rules": {
				"variable": "#b8bcc0",
				"parameter": "#a4b2d4",
				"property": "#c4bb98",
				"property.declaration": "#b8bcc0",
				"function": "#d2a8ff",
				"type": "#4EC9B0",
				"class": "#4EC9B0",
				"enum": "#4EC9B0",
				"macro": "#79c0ff",
				"enumMember": "#79c0ff",
				"operator": "#a0a6ad"
			}
		}
	},
	"editor.tokenColorCustomizations": {
		"[Dark 2026]": {
			"textMateRules": [
				{
					"scope": [
						"keyword",
						"keyword.control",
						"keyword.control.directive",
						"storage",
						"storage.type",
						"storage.modifier",
						"keyword.operator.sizeof"
					],
					"settings": {
						"foreground": "#ee8585"
					}
				},
				{
					"scope": ["comment", "punctuation.definition.comment"],
					"settings": {
						"foreground": "#6e757d"
					}
				},
				{
					"scope": ["string", "punctuation.definition.string"],
					"settings": {
						"foreground": "#7d858e"
					}
				},
				{
					"scope": "meta.preprocessor",
					"settings": {
						"foreground": "#b8bcc0"
					}
				},
				{
					"scope": [
						"keyword.operator",
						"punctuation.separator",
						"punctuation.terminator"
					],
					"settings": {
						"foreground": "#a0a6ad"
					}
				},
				{
					"scope": [
						"punctuation.section",
						"punctuation.definition.parameters",
						"punctuation.definition.begin.bracket",
						"punctuation.definition.end.bracket",
						"storage.modifier.array.bracket"
					],
					"settings": {
						"foreground": "#8b929a"
					}
				},
				{
					"scope": [
						"constant",
						"constant.numeric",
						"constant.character.escape",
						"constant.language",
						"entity.name.function.preprocessor",
						"variable.other.enummember"
					],
					"settings": {
						"foreground": "#79c0ff"
					}
				},
				{
					"scope": ["storage.type.built-in", "storage.type.built-in.primitive"],
					"settings": {
						"foreground": "#4EC9B0"
					}
				},
				{
					"scope": "variable.parameter",
					"settings": {
						"foreground": "#a4b2d4"
					}
				},
				{
					"scope": ["variable.other.member", "variable.other.property"],
					"settings": {
						"foreground": "#c4bb98"
					}
				}
			]
		}
	}
}
