# library(<name> LANGUAGES <language>... [VERSION v] [DESCRIPTION d] [URL u]
#         [PUBLIC_DEFINES ...] [PRIVATE_DEFINES ...] [INTERFACE_DEFINES ...] [OPTIONS ...]
#         [PUBLIC_LIBRARIES ...] [PRIVATE_LIBRARIES ...] [INTERFACE_LIBRARIES ...] [ENABLE_TESTING] [TESTING_LIBRARIES ...] [SKIP_INSTALL] [STATIC_LIBRARY] [INTERFACE_LIBRARY])
# source files come from source/, public headers from include/, tests from tests/.
macro(library name)
	cmake_parse_arguments(LIBRARY
		"ENABLE_TESTING;SKIP_INSTALL;STATIC_LIBRARY;INTERFACE_LIBRARY"
		"VERSION;DESCRIPTION;URL"
		"LANGUAGES;PUBLIC_DEFINES;PRIVATE_DEFINES;INTERFACE_DEFINES;OPTIONS;PUBLIC_LIBRARIES;PRIVATE_LIBRARIES;INTERFACE_LIBRARIES;TESTING_LIBRARIES"
		${ARGN})

	if (NOT APPLE AND "OBJC" IN_LIST LIBRARY_LANGUAGES)
		return()
	endif()

	enable_language(${LIBRARY_LANGUAGES})
	library_target(${ARGV})
endmacro()

function(library_target name)
	cmake_parse_arguments(PARSE_ARGV 1 ARG
		"ENABLE_TESTING;SKIP_INSTALL;STATIC_LIBRARY;INTERFACE_LIBRARY"
		"VERSION;DESCRIPTION;URL"
		"LANGUAGES;PUBLIC_DEFINES;PRIVATE_DEFINES;INTERFACE_DEFINES;OPTIONS;PUBLIC_LIBRARIES;PRIVATE_LIBRARIES;INTERFACE_LIBRARIES;TESTING_LIBRARIES")
	foreach(language ${ARG_LANGUAGES})
		list(TRANSFORM CMAKE_${language}_SOURCE_FILE_EXTENSIONS PREPEND source/*. OUTPUT_VARIABLE extensions)
		list(APPEND patterns ${extensions})
	endforeach()
	file(GLOB_RECURSE sources CONFIGURE_DEPENDS ${patterns})

	if (BUILD_SHARED_LIBS AND NOT ARG_STATIC_LIBRARY)
		set(LIBRARY_TYPE SHARED)
	else()
		set(LIBRARY_TYPE STATIC)
	endif()

	if (ARG_INTERFACE_LIBRARY)
		add_library(${name} INTERFACE)
		target_sources(${name} INTERFACE $<BUILD_INTERFACE:${sources}>)
		set(PUBLIC_VISIBILITY INTERFACE)
		set(PRIVATE_VISIBILITY INTERFACE)
		set(INTERFACE_VISIBILITY INTERFACE)
	else()
		add_library(${name} ${LIBRARY_TYPE} ${sources})
		set(PUBLIC_VISIBILITY PUBLIC)
		set(PRIVATE_VISIBILITY PRIVATE)
		set(INTERFACE_VISIBILITY INTERFACE)
	endif()

	set_target_properties(${name} PROPERTIES
		C_STANDARD    23
		OBJC_STANDARD 23
		CXX_STANDARD  23)
	if(ARG_LANGUAGES STREQUAL ASM_NASM)
		set_target_properties(${name} PROPERTIES LINKER_LANGUAGE C)
	endif()

	target_compile_definitions(${name}
		${PUBLIC_VISIBILITY} ${ARG_PUBLIC_DEFINES}
		${PRIVATE_VISIBILITY} ${ARG_PRIVATE_DEFINES}
		${INTERFACE_VISIBILITY} ${ARG_INTERFACE_DEFINES})

	target_compile_options(${name} ${PRIVATE_VISIBILITY} ${ARG_OPTIONS})
	target_include_directories(${name} ${PUBLIC_VISIBILITY}
		$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
		$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)

	if (APPLE AND "OBJC" IN_LIST ARG_LANGUAGES)
		find_library(FOUNDATION_FRAMEWORK Foundation REQUIRED)
		find_library(COCOA_FRAMEWORK Cocoa REQUIRED)
		find_library(CORE_FOUNDATION_LIBRARY CoreFoundation REQUIRED)
		find_library(QUARTZ_CORE_LIBRARY QuartzCore REQUIRED)
		list(APPEND ARG_PRIVATE_LIBRARIES
			${FOUNDATION_FRAMEWORK}
			${COCOA_FRAMEWORK}
			${CORE_FOUNDATION_LIBRARY}
			${QUARTZ_CORE_LIBRARY})
	endif()

	if(NOT ARG_INTERFACE_LIBRARY)
		list(APPEND ARG_PRIVATE_LIBRARIES $<BUILD_LOCAL_INTERFACE:debug_flags>)
	endif()

	target_link_libraries(${name}
		${PUBLIC_VISIBILITY}  ${ARG_PUBLIC_LIBRARIES}
		${PRIVATE_VISIBILITY} ${ARG_PRIVATE_LIBRARIES}
		${INTERFACE_VISIBILITY} ${ARG_INTERFACE_LIBRARIES})

	if (ARG_ENABLE_TESTING AND NOT ARG_INTERFACE_LIBRARY)
		tests(${name}
			DEFINES ${ARG_PRIVATE_DEFINES}
			INCLUDES source
			LIBRARIES ${name} ${ARG_PRIVATE_LIBRARIES} ${ARG_TESTING_LIBRARIES})
	endif()

	if (NOT ARG_SKIP_INSTALL)
		list(JOIN ARG_PUBLIC_LIBRARIES  " " PC_REQUIRES)
		list(JOIN ARG_PRIVATE_LIBRARIES " " PC_REQUIRES_PRIVATE)
		list(TRANSFORM ARG_PUBLIC_DEFINES PREPEND -D OUTPUT_VARIABLE PC_DEFINES)
		list(JOIN PC_DEFINES " " PC_CFLAGS)

		configure_file(
			${CMAKE_SOURCE_DIR}/library.pc.in
			${CMAKE_CURRENT_BINARY_DIR}/${name}.pc @ONLY)
		install(
			FILES ${CMAKE_CURRENT_BINARY_DIR}/${name}.pc
			DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
		install(
			DIRECTORY include/
			DESTINATION ${CMAKE_INSTALL_INCLUDEDIR} OPTIONAL)
		install(
			DIRECTORY assets/
			DESTINATION ${CMAKE_INSTALL_DATADIR}/${name}/ OPTIONAL)
		install(
			TARGETS ${name}
			EXPORT ${name}Config)
		install(
			EXPORT ${name}Config
			DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/${name})
	endif()
endfunction()
